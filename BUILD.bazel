# TODO(joshuaduong): This file should be auto-generated.

load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_python//python:defs.bzl", "py_binary")

# -------------------------------------------------------------------------
# 1. Define Filegroups
# These allow us to reuse source lists without duplication.
# -------------------------------------------------------------------------

filegroup(
    name = "util_srcs",
    srcs = [
        "src/wayland-private.h",
        "src/wayland-util.c",
        "src/wayland-util.h",
    ],
)

filegroup(
    name = "private_srcs",
    srcs = [
        "src/connection.c",
        "src/wayland-os.c",
        "src/wayland-os.h",
    ],
)

# -------------------------------------------------------------------------
# 2. Main Targets
# We reference the filegroups in 'srcs', effectively compiling them
# directly into these libraries.
# -------------------------------------------------------------------------

cc_library(
    name = "wayland-client",
    srcs = [
        "config.h",
        "src/wayland-client.c",
        "src/wayland-protocol.c",
        ":private_srcs",  # <--- Includes connection & OS code
        ":util_srcs",  # <--- Includes util code
    ],
    hdrs = [
        "src/wayland-client.h",
        "src/wayland-client-core.h",
        "src/wayland-client-protocol.h",
        "src/wayland-version.h",
        # Note: headers inside filegroups are available to sources,
        # but listing public headers here is still good practice for consumers.
    ],
    copts = ["-Wno-implicit-function-declaration"],
    defines = [
        "_FILE_OFFSET_BITS=64",
        "_POSIX_C_SOURCE=200809L",
    ],
    includes = [
        ".",
        "platform/linux-x86_64",
        "src",
    ],
    deps = [
        "@libffi//:ffi",
    ],
)

cc_binary(
    name = "wayland-scanner",
    srcs = [
        "config.h",
        "src/scanner.c",
        "src/wayland-version.h",
        ":util_srcs",  # <--- Reusing util sources here
    ],
    copts = ["-Wno-implicit-function-declaration"],
    defines = [
        "_FILE_OFFSET_BITS=64",
        "_POSIX_C_SOURCE=200809L",
    ],
    includes = [
        ".",
        "platform/linux-x86_64",
        "src",
    ],
    deps = [
        "@libexpat",
    ],
)

cc_binary(
    name = "wayland-server",
    srcs = [
        "config.h",
        "egl/wayland-egl-backend.h",
        "src/event-loop.c",
        "src/wayland-protocol.c",
        "src/wayland-server.c",
        "src/wayland-server.h",
        "src/wayland-server-core.h",
        "src/wayland-server-private.h",
        "src/wayland-server-protocol.h",
        "src/wayland-shm.c",
        "src/wayland-version.h",
        ":private_srcs",  # <--- Reusing private sources here
        ":util_srcs",  # <--- Reusing util sources here
    ],
    copts = ["-Wno-implicit-function-declaration"],
    defines = [
        "_FILE_OFFSET_BITS=64",
        "_POSIX_C_SOURCE=200809L",
    ],
    includes = [
        ".",
        "egl",
        "platform/linux-x86_64",
        "src",
    ],
    linkshared = True,
    deps = [
        "@libffi//:ffi",
    ],
)

# -------------------------------------------------------------------------
# 3. Legacy Targets (Optional)
# If you still need these standalone targets for other reasons,
# they can also just consume the filegroups.
# -------------------------------------------------------------------------

cc_library(
    name = "libwayland-private",
    srcs = [":private_srcs"],
    hdrs = ["config.h"],
    copts = ["-Wno-implicit-function-declaration"],
    defines = [
        "_FILE_OFFSET_BITS=64",
        "_POSIX_C_SOURCE=200809L",
    ],
    includes = [
        "platform/linux-x86_64",
        "src",
    ],
    deps = ["@libffi//:ffi"],
)

cc_library(
    name = "libwayland-util",
    srcs = [":util_srcs"],
    copts = ["-Wno-implicit-function-declaration"],
    defines = [
        "_FILE_OFFSET_BITS=64",
        "_POSIX_C_SOURCE=200809L",
    ],
    includes = [
        "platform/linux-x86_64",
        "src",
    ],
)

# -------------------------------------------------------------------------
# 4. Code Generation (Unchanged)
# -------------------------------------------------------------------------

genrule(
    name = "generate_protocol_source",
    srcs = ["protocol/wayland.xml"],
    outs = ["src/wayland-protocol.c"],
    cmd = "$(location :wayland-scanner) -s public-code $(location protocol/wayland.xml) $(location src/wayland-protocol.c)",
    tools = [":wayland-scanner"],
)

genrule(
    name = "generate_wayland_client_protocol_core_h",
    srcs = ["protocol/wayland.xml"],
    outs = ["src/wayland-client-protocol-core.h"],
    cmd = "$(location :wayland-scanner) -s client-header -c $(location protocol/wayland.xml) $(location src/wayland-client-protocol-core.h)",
    tools = [":wayland-scanner"],
)

genrule(
    name = "generate_wayland_client_protocol_h",
    srcs = ["protocol/wayland.xml"],
    outs = ["src/wayland-client-protocol.h"],
    cmd = "$(location :wayland-scanner) -s client-header $(location protocol/wayland.xml) $(location src/wayland-client-protocol.h)",
    tools = [":wayland-scanner"],
)

genrule(
    name = "generate_wayland_dtd_h",
    srcs = ["protocol/wayland.dtd"],
    outs = ["src/wayland.dtd.h"],
    cmd = "$(location :embed) $(location protocol/wayland.dtd) wayland_dtd > $(location src/wayland.dtd.h)",
    tools = [":embed"],
)

genrule(
    name = "generate_wayland_server_protocol_core_h",
    srcs = ["protocol/wayland.xml"],
    outs = ["src/wayland-server-protocol-core.h"],
    cmd = "$(location :wayland-scanner) -s server-header -c $(location protocol/wayland.xml) $(location src/wayland-server-protocol-core.h)",
    tools = [":wayland-scanner"],
)

genrule(
    name = "generate_wayland_server_protocol_h",
    srcs = ["protocol/wayland.xml"],
    outs = ["src/wayland-server-protocol.h"],
    cmd = "$(location :wayland-scanner) -s server-header $(location protocol/wayland.xml) $(location src/wayland-server-protocol.h)",
    tools = [":wayland-scanner"],
)

py_binary(
    name = "embed",
    srcs = ["src/embed.py"],
)
