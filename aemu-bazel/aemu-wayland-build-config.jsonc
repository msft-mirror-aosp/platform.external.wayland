{
  // This file configures the build for a Meson-based project. It is used by the
  // generic MesonProjectBuilder to generate toolchains, dependencies, and other
  // necessary build files.
  //
  // The structure is composed of two main sections:
  // 1. "common": Holds configurations that are shared across all target platforms.
  // 2. "platforms": Contains platform-specific configurations that can override
  //    or extend the common settings.
  //
  // The builder merges these sections based on the target platform. For example,
  // when building for "linux-x64", the builder will merge the settings from
  // "common" and "platforms.linux-x64".
  "project_name": "wayland",
  "source_path": "third_party/wayland",

  "common": {
    // "dependencies": A dictionary of libraries required for the build. These
    // are used to generate pkg-config (.pc) files, which Meson uses to find
    // libraries and their headers.
    "dependencies": {
    },
    // "meson_options": A dictionary of Meson feature flags and settings.
    // These are passed to the `meson setup` command.
    "meson_options": {
      "-Dlibraries": "true",
      "-Dscanner": "true",
      "-Dtests": "false",
      "-Ddocumentation": "false",
      "-Ddtd_validation": "false",
      "-Dicon_directory": "false"
    },
    // "generated_files": A list of files to be generated by the build script.
    "generated_files": [
    ]
  },
  "platforms": {
    "linux-x64": {
      "dependencies": {
        "libffi": {
          "lib_type": "bazel",
          "bazel_target": "@libffi//:ffi",
          "version": "3.4.7.bcr.3.aemu",
          "shim": {
            "name": "libffi",
            "Libs": "-lffi"
          }
        },
        "libexpat": {
          "lib_type": "bazel",
          "bazel_target": "@libexpat//:libexpat",
          "version": "2.7.1.aemu",
          "shim": {
            "name": "expat",
            "Libs": "-lexpat"
          }
        }
      }
    }
  }
}
